    "6":  { "target": { "variant": "policy.property.us-fl.personal.safepoint", "field": "effective_date" } },
    "10": { "target": { "variant": "dwelling.property.us.personal", "field": "year_built" } },
    "11": { "target": { "variant": "dwelling.property.us.personal", "field": "construction" } },
    "12": { "target": { "variant": "dwelling_asset.property.personal", "field": "protection_class" } },
    "13": { "target": { "variant": "dwelling.property.us.personal", "field": "number_of_stories" } },
    "14": { "target": { "variant": "dwelling.property.us.personal", "field": "number_of_units" },
            "transform": { "map": { "1 to 4": "4", "5+": "5" } },
            "note": "Band to integer (D1)." },
    "16": { "target": { "variant": "dwelling.property.us.personal", "field": "burglar_alarm" } },
    "19": { "target": { "variant": "dwelling.property.us.personal", "field": "building_code_effectiveness_grading" } },
    "22": { "target": { "variant": "dwelling.property.us.personal", "field": "roof_deck_attachment" } },
    "23": { "target": { "variant": "wind_mitigation_verification.property.us-fl.personal.safepoint", "field": "roof_shape" },
