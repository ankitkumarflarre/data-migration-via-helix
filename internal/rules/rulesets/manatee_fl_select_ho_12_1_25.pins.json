    "25": { "target": { "variant": "dwelling.property.us.personal", "field": "secondary_water_resistance" },
            "transform": { "map": { "SWR": "true", "No SWR": "false" } } },
    "26": { "target": { "variant": "dwelling.property.us.personal", "field": "opening_protection" } },
    "27": { "target": { "variant": "dwelling.property.us.personal", "field": "wind_speed_design" } },
    "28": { "target": { "variant": "dwelling.property.us.personal", "field": "wind_speed_location" } },
    "45": { "target": { "variant": "section_icoverages.property.us.personal", "field": "equipment_breakdown" } },
    "50": { "target": { "variant": "line.property.us.personal", "field": "consent_to_rate" },
